DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Prod only: comma-separated origins allowed to call the API cross-origin,
# e.g. https://<cloudfront-domain>. Unused by dev.py (that uses CORS_ALLOW_ALL_ORIGINS).
DJANGO_CORS_ALLOWED_ORIGINS=

POSTGRES_DB=psychology_app
POSTGRES_USER=psychology_app
POSTGRES_PASSWORD=psychology_app
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.6
# Cheaper/smaller model used only for the on-topic/crisis pre-flight classifier
GROQ_MODERATION_MODEL=openai/gpt-oss-20b
GROQ_MODERATION_MAX_TOKENS=40
